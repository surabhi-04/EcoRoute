# Stage 1: Distributed Build Engine for Vercel
FROM maven:3.8.5-openjdk-17 AS build-engine
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn clean package -DskipTests

# Stage 2: Production Runtime Environment for Vercel
FROM openjdk:17-slim
WORKDIR /runtime
COPY --from=build-engine /app/target/ecoroute-0.0.1-SNAPSHOT.jar ecoroute.jar
ENV PORT=8080
EXPOSE ${PORT}
ENTRYPOINT ["sh", "-c", "java -Dserver.port=${PORT:-8080} -jar ecoroute.jar"]
